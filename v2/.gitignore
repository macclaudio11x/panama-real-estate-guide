# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Synced project photography — regenerated by scripts/sync-airtable.mjs.
# Kept out of git to avoid the 91MB binary bloat v1 accumulated. Long term
# these belong on a CDN (R2/Cloudinary), not in the repo.
/public/projects/

# Generated by scripts/preview-welcome-email.mjs — never committed.
preview-welcome-email.html
